NINE_T_DATA_DIR=/absolute/path/to/9t/data
NINE_T_SETUP_TOKEN=replace-with-a-random-secret
NINE_T_HTTPS=true
# Optional:
# NINE_T_BACKUP_DIR=/absolute/path/to/9t/backups
# NINE_T_BACKUP_KEEP=14
# PORT=3265
# NINE_T_HOST=0.0.0.0
# NODE_ENV=production
# Opt-in Postgres migration target (unset = JSON files, no behavior change):
# NINE_T_DATABASE_URL=postgresql://9t:change-me@localhost:5432/9t
# Blob storage (default local filesystem; s3 = S3-compatible bucket):
# NINE_T_STORAGE_DRIVER=local
# NINE_T_S3_ENDPOINT=https://s3.example.com
# NINE_T_S3_REGION=us-east-1
# NINE_T_S3_BUCKET=9t-blobs
# NINE_T_S3_ACCESS_KEY=change-me
# NINE_T_S3_SECRET_KEY=change-me
# NINE_T_S3_PREFIX=9t/
# NINE_T_S3_FORCE_PATH_STYLE=true
