[Unit]
Description=9t self-hosted workspace
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/9t
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/9t/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
