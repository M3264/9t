---
import Base from './Base.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Page {
  slug: string;
  title: string;
}
interface Props {
  entry: CollectionEntry<'docs'>;
  slug: string;
  pages: Page[];
  prev?: Page;
  next?: Page;
}
const { entry, slug, pages, prev, next } = Astro.props;
const { Content } = await render(entry);
const href = (s: string) => (s === 'index' ? '/docs/' : `/docs/${s}/`);
---
<Base title={entry.data.title} description={entry.data.description} section="docs" search>
  <main class="wrap" id="main">
    <div class="docs-shell" id="docs-shell">
      <aside class="docs-side" aria-label="Documentation sections">
        <h2>Documentation</h2>
        <ul>
          {pages.map((p) => (
            <li>
              <a
                href={href(p.slug)}
                aria-current={p.slug === slug ? 'page' : undefined}
              >{p.title}</a>
            </li>
          ))}
        </ul>
      </aside>
      <div>
        <button class="icon-btn menu-btn" id="menu-btn" aria-label="Open sections menu">☰ Sections</button>
        <article class="prose">
          <Content />
        </article>
        <nav class="docs-nav" aria-label="Previous and next">
          {prev
            ? <a href={href(prev.slug)}><small>← Previous</small>{prev.title}</a>
            : <span></span>}
          {next
            ? <a class="next" href={href(next.slug)}><small>Next →</small>{next.title}</a>
            : <span></span>}
        </nav>
      </div>
    </div>
  </main>
  <div id="search-mount" hidden></div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const slot = document.getElementById('search-slot');
      if (slot && window.PagefindUI) {
        const box = document.createElement('div');
        box.className = 'pagefind-ui';
        slot.replaceWith(box);
        new window.PagefindUI({ element: box, showSubResults: true, showImages: false });
      }
    });
    document.getElementById('menu-btn')?.addEventListener('click', () => {
      document.getElementById('docs-shell')?.classList.toggle('open');
    });
  </script>
</Base>
