    <shortcut
        android:shortcutId="inbox"
        android:enabled="true"
        android:icon="@drawable/ic_ninet"
        android:shortcutShortLabel="@string/shortcut_inbox_short"
        android:shortcutLongLabel="@string/shortcut_inbox_long">
        <intent
            android:action="xyz.kennyy.ninet.INBOX"
            android:targetPackage="xyz.kennyy.ninet"
            android:targetClass="xyz.kennyy.ninet.MainActivity" />
